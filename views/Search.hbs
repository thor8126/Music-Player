<h1>Search</h1>
<p style="color: var(--text-secondary); margin: 8px 0 20px;">Find your favourite songs</p>

<form id="search-form" action="/search" method="POST">
  <div class="input-group" style="flex-wrap: nowrap; gap: 12px; max-width: 520px;">
    <input type="text" id="search-input" name="q" placeholder="What do you want to listen to?" required />
    <button type="submit" id="submit">Search</button>
  </div>
</form>
