<br>
<center>
  <h4>{{title}}</h4>
</center>
<hr>

<div class="table" id="playlist-table-body">
  <table>
    <thead>
      <tr>
        <th></th>
        <th>Title</th>
        <th>Artist</th>
        <th></th>
        <th>Duration</th>
      </tr>
    </thead>
    <tbody>
      {{#each tracks}}
      <tr>
        <td>{{@index}}</td>
        <td><button class="list_play" data-track-id="{{this.id}}">
            {{#if image}}
            <img class="rounded-4" src="{{this.image}}" alt="{{this.name}}">
            {{/if}}
            {{this.name}}
          </button>
        </td>
        <td>{{this.artist}}</td>
        <td><button class="addtofav" data-track-id="{{this.id}}"><i class="fas fa-heart"></i></button></td>
        <td>{{this.duration}}</td>
        <td class="song-id" style="display: none;">{{this.id}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</div>

<br><br>



<script>
  document.querySelectorAll(".addtofav").forEach((button) => {
    button.addEventListener("click", async function (event) {
      event.preventDefault();
      const trackId = this.dataset.trackId;
      const response = await fetch(`/addtofavourites/${trackId}`, {
        method: "GET",
      });
      if (response.status === 200) {
        // The song was removed from favourites: drop its row from the table.
        const row = this.closest("tr");
        if (row) row.remove();
      } else {
        console.error("Failed to update favourites.");
      }
    });
  });
</script>
